# ========================
# 1. DATA (CRITICAL)
# ========================
03_data/

# ========================
# 2. PYTHON ENVIRONMENTS
# ========================
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.env
.ipynb_checkpoints/

# ========================
# 3. R ENVIRONMENTS
# ========================
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# ========================
# 4. OS & SYSTEM FILES
# ========================
.DS_Store
Thumbs.db

# Microsoft Office lock files (created while a workbook is open)
~$*.xlsx
~$*.xls
~$*.docx
~$*.doc
~$*.pptx

# ========================
# 5. CLAUDE HIDDEN FILES
# ========================
# Ignore all private session logs, cache, local settings, and memory
.claude/*

# Whitelist the AI architecture to share with the team
!.claude/skills/
!.claude/agents/
!.claude/rules/
!.claude/hooks/
!.claude/commands/
!.claude/settings.json

# Personal, per-person Claude instructions (loaded next to CLAUDE.md, never shared)
CLAUDE.local.md

# Quarto previews rendered from a SKILL.md for human reading. Claude only reads
# SKILL.md, so the HTML and its support-library folder are noise in every copy.
.claude/skills/**/SKILL.html
.claude/skills/**/SKILL_files/

# ========================
# 6. AUTO-GENERATED BACKUPS
# ========================
# Master scripts auto-backup human-edited workbooks before re-rendering.
# The workbook itself is tracked in git; per-run snapshots are not.
02_survey_tools/01_quant_tools/_backups/

# ========================
# 7. REPORT BUILD INTERMEDIATES
# ========================
# causal-report skill: disposable build trees written next to each report spec.
# Anchored to 06_workspace (where report sources live) rather than to a single
# folder, so a report drafted anywhere beneath it is covered.
# The .causal-report/ baseline IS tracked -- the .docx round trip needs it.
06_workspace/**/build/
**/.causal-report/pre_import.qmd
