{
  "permissions": {
    "deny": [
      "Edit(/04_scripts/00_setup_paths.*)",
      "Edit(/09_legacy_vault/**)",
      "Edit(~/Library/CloudStorage/**/01_raw_data/**)",
      "Bash(Rscript -e *)",
      "Bash(Rscript * -e *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/check_large_files.sh"
          }
        ]
      }
    ]
  }
}
